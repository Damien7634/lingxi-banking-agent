# ── 运行环境 ─────────────────────────────────────────────────────
APP_ENV=development              # production 时强制 Secure Cookie、https Origin、关闭注册
LISTEN_ADDR=127.0.0.1:8080
APP_TIMEZONE=Asia/Shanghai       # 账单月份/日限额/生日的业务时区

# ── 数据库（MySQL 8） ───────────────────────────────────────────
# 建议为应用单独建库和最小权限账号，不要用 root：
#   CREATE DATABASE lingxi CHARACTER SET utf8mb4;
#   CREATE USER 'lingxi'@'localhost' IDENTIFIED BY '<强密码>';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, REFERENCES ON lingxi.* TO 'lingxi'@'localhost';
DATABASE_DSN=lingxi:<password>@tcp(127.0.0.1:3306)/lingxi

# ── 安全 ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # CSRF Origin 白名单
COOKIE_SECURE=false              # 生产环境自动为 true
TRUST_PROXY=false                # 仅在会覆盖 X-Forwarded-For 的反向代理之后才开启
SESSION_IDLE_TTL=30m
SESSION_ABSOLUTE_TTL=12h
ALLOW_REGISTER=false
SINGLE_TRANSFER_LIMIT_CENTS=100000000   # 单笔 ¥100 万
DAILY_TRANSFER_LIMIT_CENTS=200000000    # 单日 ¥200 万

# ── AI（OpenAI 兼容接口，仅服务端持有） ───────────────────────────
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── 生产部署可选：由 Go 直接托管前端构建产物 ───────────────────────
# STATIC_DIR=../dist/public
